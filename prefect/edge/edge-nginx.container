[Unit]
Description=Prefect Edge nginx
After=network-online.target

[Container]
Image=docker.io/library/nginx:alpine
Pod=edge.pod
Volume=%h/.local/share/prefect/edge/nginx.conf:/etc/nginx/nginx.conf:ro
Volume=%h/.local/share/prefect/edge/routes:/etc/nginx/prefect-routes:ro
Volume=%h/.local/share/prefect/edge/certs:/etc/nginx/certs:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
