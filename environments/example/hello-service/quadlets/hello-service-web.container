[Unit]
Description=Propraetor example hello-service web

[Container]
Image=docker.io/library/nginx:alpine
ContainerName=hello-service-web
Pod=hello-service.pod
Volume=/var/lib/host-volume/data/workloads/hello-service:/var/lib/workload:rw

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
