# Copy to durable_destroy_override.tf (gitignored; Terraform override file) only for
# Teardown, together with -var=allow_durable_destroy=true. Remove after Teardown.
# See docs/runbooks/durable-stack-migration.md.

resource "digitalocean_volume" "web" {
  lifecycle {
    prevent_destroy = false
  }
}

resource "digitalocean_reserved_ip" "web" {
  lifecycle {
    prevent_destroy = false
  }
}

resource "digitalocean_domain" "this" {
  lifecycle {
    prevent_destroy = false
  }
}

resource "digitalocean_record" "a" {
  lifecycle {
    prevent_destroy = false
  }
}
