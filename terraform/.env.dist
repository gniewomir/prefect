# Documentation only — this file is not loaded automatically.
# Export these in your shell (or CI) before running terraform.
#
# Naming:
# - Provider-conventional credentials keep the provider's expected name
#   (DigitalOcean Terraform provider discovers DIGITALOCEAN_TOKEN).
# - Terraform input variables are set via TF_VAR_<variable_name>.
# - Other Prefect-specific env vars use the PREFECT_ prefix.

DIGITALOCEAN_TOKEN=
TF_VAR_DIGITALOCEAN_PUBLIC_KEY=
